<?xml version="1.0" encoding="utf-8"?>
<!-- See https://developer.android.com/about/versions/12/backup-restore#xml-changes -->
<data-extraction-rules>
    <cloud-backup>
        <!-- The encrypted FDV sign-in is useless without this device's Keystore key -->
        <exclude domain="file" path="datastore/fdv_auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/fdv_auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>